# Dev/test runtime env for the connector container, targeting the Nord Pool *test*
# environment. Committed on purpose: everything below is endpoint configuration, and
# the account credentials are deliberately absent — the launcher fetches
# NORDPOOL_MARKET_DATA_API_USERNAME / _PASSWORD from the Secrets Manager bundle via
# aws-vault (PROFILE defaults to nordpool-dev; NORDPOOL_SECRET_ID below names the
# bundle). Keep it that way: never inline a credential here.
#
# Loaded as compose.yaml's `env_file:` for the connector service; any ${VAR} set here
# wins over the fetched bundle keys. Run it:
#   scripts/dev-stack.sh                          # ENV_FILE defaults to this file
#
# Values are literal in an env-file — no surrounding quotes (podman keeps them).

# --- AWS / Secrets Manager ---------------------------------------------------
# Names the Secrets Manager bundle the launcher fetches via aws-vault. The connector itself
# never reads it (the launcher passes -e NORDPOOL_SECRET_ID= so the container won't try).
NORDPOOL_SECRET_ID=NORDPOOL

# --- Nord Pool SSO (auth) — test environment ---------------------------------
NORDPOOL_MARKET_DATA_API_PROTOCOL=https
NORDPOOL_MARKET_DATA_API_HOST=sts.test.nordpoolgroup.com
NORDPOOL_MARKET_DATA_API_TOKEN_URI=/connect/token
NORDPOOL_MARKET_DATA_API_SCOPE=intraday_api
NORDPOOL_MARKET_DATA_API_CLIENT_ID=client_intraday_api
# Not a credential: Nord Pool publishes this client secret in its public API docs and it
# is the same value for every integrator — the account username/password are the secret,
# and those come from the bundle.
NORDPOOL_MARKET_DATA_API_CLIENT_SECRET=<from-nord-pool-api-docs>

# --- Nord Pool intraday PMD WebSocket — test ---------------------------------
NORDPOOL_MARKET_DATA_API_WEBSOCKET_HOST=intraday-pmd-api-binary-ws.test.nordpoolgroup.com
NORDPOOL_MARKET_DATA_API_WEBSOCKET_PORT=443
